# ==============================================================================
# Indus Global Trade — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local overrides.
# In production, set these variables in your hosting provider's dashboard (e.g., Cloudflare Pages, Netlify, Vercel).
#
# NOTE: Only variables prefixed with NEXT_PUBLIC_ are accessible to the browser.
# DO NOT place private API keys, SMTP credentials, or database secrets in this file.
# ==============================================================================

# Production Site URL (Used for canonical metadata, sitemap.xml, robots.txt, and Open Graph URLs)
# Example: https://indusglobaltrade.com
NEXT_PUBLIC_SITE_URL=https://indusglobaltrade.com

# Inquiry Submission Endpoint (Optional)
# Static form submission service (e.g., Formspree, Formkeep, Basin, Web3Forms, or AWS API Gateway endpoint)
# If left empty, the site runs in static demo mode (logs submission in development, displays success UI).
# Example: https://formspree.io/f/your_form_id
NEXT_PUBLIC_INQUIRY_ENDPOINT=
