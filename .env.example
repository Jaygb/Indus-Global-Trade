# ==============================================================================
# Indus Global Trade — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In production, set these variables in your hosting provider's dashboard (e.g. Vercel).
# ==============================================================================

# Production Site URL
NEXT_PUBLIC_SITE_URL=

# ==============================================================================
# Gmail SMTP Dispatch Configuration
# ==============================================================================
# Automated email dispatch from jayg@gmail.com to jay@gmail.com
#
# Steps to generate your 16-character Gmail App Password:
# 1. Open Google Account for jay@gmail.com -> Security
# 2. Ensure 2-Step Verification is turned ON
# 3. Navigate to "App passwords" (https://myaccount.google.com/apppasswords)
# 4. Create an App password (e.g. named "Indus Web Portal")
# 5. Copy the generated 16-character password into SMTP_PASS in your .env.local file

ADMIN_EMAIL=

SMTP_USER=
SMTP_PASS=